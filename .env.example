# Copy to .env and fill in the real password. .env is git-ignored; never commit it.
#
# The application role is created without superuser rights and granted only
# SELECT/INSERT/UPDATE/DELETE on the finance tables:
#
#   CREATE ROLE bambo_finance_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   GRANT CONNECT ON DATABASE bambo_finance_dev TO bambo_finance_app;
#   GRANT USAGE ON SCHEMA public TO bambo_finance_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO bambo_finance_app;

FINANCE_DEV_DSN=postgresql://bambo_finance_app:CHANGE_ME@127.0.0.1:55432/bambo_finance_dev

# Owner role, used only for the migration/seed step. The service never runs as this,
# and a deployed release runs migrations separately rather than at start-up.
FINANCE_MIGRATION_DSN=postgresql://OWNER:CHANGE_ME@127.0.0.1:55432/bambo_finance_dev

APP_ENV=development
DEBUG=false
# The finance development host serves the API and the frontend from one origin, and the
# browser client refuses cross-origin calls -- so there is no CORS configuration and
# nothing reads this value. It is kept only as documentation of where the demo lives.
FRONTEND_ORIGIN=http://127.0.0.1:8010

# Overrides the finance demo port. Optional; the default is 8010.
# FINANCE_DEMO_PORT=8010

# Development fixtures are OFF unless this says so explicitly.
#
# Two explicit positive conditions are required, and neither has a default:
#   1. APP_ENV is actually set, to development / dev / test
#   2. this flag is explicitly true
#
# An unset APP_ENV is a refusal even with the flag set. APP_ENV reads as "development" when
# unset -- a sensible default for describing an environment, a dangerous one for authorizing
# writes -- so seeding checks the raw setting instead. No default may authorize fixtures.
# Staging is not seedable at all: it is a deployed environment, and demo invoices there look
# exactly like real ones to whoever is reviewing them.
#
# Production must never receive mock data. Leave this unset anywhere that is not your own
# machine.
FINANCE_ALLOW_SEED=true
