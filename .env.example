# Copy to .env and fill in the real password. .env is git-ignored; never commit it.
#
# The application role is created without superuser rights and granted only
# SELECT/INSERT/UPDATE/DELETE on the finance tables:
#
#   CREATE ROLE bambo_finance_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   GRANT CONNECT ON DATABASE bambo_finance_dev TO bambo_finance_app;
#   GRANT USAGE ON SCHEMA public TO bambo_finance_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO bambo_finance_app;

FINANCE_DEV_DSN=postgresql://bambo_finance_app:CHANGE_ME@127.0.0.1:55432/bambo_finance_dev

# Owner role, used only for the migration/seed step. The service never runs as this,
# and a deployed release runs migrations separately rather than at start-up.
FINANCE_MIGRATION_DSN=postgresql://OWNER:CHANGE_ME@127.0.0.1:55432/bambo_finance_dev

APP_ENV=development
DEBUG=false
# The finance development host serves the API and the frontend from one origin, and the
# browser client refuses cross-origin calls -- so there is no CORS configuration and
# nothing reads this value. It is kept only as documentation of where the demo lives.
FRONTEND_ORIGIN=http://127.0.0.1:8010

# Overrides the finance demo port. Optional; the default is 8010.
# FINANCE_DEMO_PORT=8010

# Development fixtures are OFF unless this says so explicitly.
#
# Two explicit positive conditions are required, and neither has a default:
#   1. APP_ENV is actually set, to development / dev / test
#   2. this flag is explicitly true
#
# An unset APP_ENV is a refusal even with the flag set. APP_ENV reads as "development" when
# unset -- a sensible default for describing an environment, a dangerous one for authorizing
# writes -- so seeding checks the raw setting instead. No default may authorize fixtures.
# Staging is not seedable at all: it is a deployed environment, and demo invoices there look
# exactly like real ones to whoever is reviewing them.
#
# Production must never receive mock data. Leave this unset anywhere that is not your own
# machine.
FINANCE_ALLOW_SEED=false

# The approved server storage root for schedule files. Deployment supplies this; no
# source edit is needed, and nothing here is a default -- an unset root means import is
# off rather than reading from somewhere nobody chose.
#
# A local filesystem path, or any path the operating system has mounted. Object storage
# is NOT supported: a remote object reference is not a filesystem path and this module
# does not pretend it is.
#
# The file is read as <MPP_IMPORT_ROOT>/<projectId>.mpp. A directory is never imported
# wholesale: a file whose stem is not a Finance project is skipped.
# Never replace an unreadable selected file with a different copy.
# MPP_IMPORT_ROOT=<approved storage root>
# MPP_JAVA_HOME=<path to a JRE 17 for MPXJ>
MPP_IMPORT_ENABLED=false
# Upper bound on an importable schedule, in megabytes. Default 100.
# MPP_MAX_FILE_SIZE_MB=100
# How often the periodic tick looks for a changed file. Unset means no tick.
# MPP_IMPORT_INTERVAL_MINUTES=
# Whether progress snapshots come from Core. Its absence answers 404 for every
# Core-hosted snapshot, which looks like missing data and is missing wiring.
# FINANCE_CORE_PROGRESS=
# Invoice extraction provider. Without `self_hosted` the host installs an adapter that
# says "unavailable" rather than one that guesses. No provider key belongs in this file.
# EXTRACTION_PROVIDER=
# FINANCE_CORE_DSN=postgresql://APP_ROLE:CHANGE_ME@127.0.0.1:5432/LOCAL_DATABASE
# FINANCE_DEMO_USER_ID=<existing local user UUID>
# FINANCE_DEMO_ORGANIZATION_ID=<existing local organization UUID>
# FINANCE_DEMO_PROJECT_ID=<verified project ID>

# ---------------------------------------------------------------- AI extraction
# AvalAI reads the OCR/Whisper text a second time and offers candidates for the fields
# the deterministic parser could not find. It never overrides the parser and never
# creates an invoice -- everything it returns is a draft field a person confirms.
#
# UNSET IS OFF. With no key the extractor is skipped and the pipeline behaves exactly as
# it did before: OCR text plus the parser's own candidates.
AVALAI_API_KEY=
# Optional. The defaults are the public gateway and a small model.
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini

# ------------------------------------------------- automated material price import
# The shared secret n8n presents to trigger the daily import after it finishes writing
# the Google Sheet. It is the ONE place Finance accepts a credential of its own: every
# other route takes identity from the host, and this exists because n8n is not a person
# and cannot hold a session.
#
# UNSET IS OFF. With no key the endpoint accepts only an authenticated user with
# finance.edit, exactly as before. A key shorter than 32 characters is treated as unset
# and the host accepts no automated call at all -- failing closed, because a door that
# looks locked is worse than one visibly open.
#
# Generate one that is actually random, e.g.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# n8n sends it as a header, with no body:
#     POST /api/projects/<projectId>/finance/material-prices/import-runs?force=true
#     X-FINANCE-SERVICE-KEY: <the value below>
#
# It cannot name the sheet, the organization or any price. The sheet is
# FINANCE_MATERIAL_PRICE_SHEET_URL and the organization is read from the project's own
# provider configuration.
FINANCE_MATERIAL_PRICE_IMPORT_SERVICE_KEY=
