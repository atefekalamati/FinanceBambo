# Copy to .env and fill in the real password. .env is git-ignored; never commit it.
#
# The application role is created without superuser rights and granted only
# SELECT/INSERT/UPDATE/DELETE on the finance tables:
#
#   CREATE ROLE bambo_finance_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   GRANT CONNECT ON DATABASE bambo_finance_dev TO bambo_finance_app;
#   GRANT USAGE ON SCHEMA public TO bambo_finance_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO bambo_finance_app;

FINANCE_DEV_DSN=postgresql://bambo_finance_app:CHANGE_ME@127.0.0.1:55432/bambo_finance_dev

# Owner role, used only for the migration/seed step. The service never runs as this,
# and a deployed release runs migrations separately rather than at start-up.
FINANCE_MIGRATION_DSN=postgresql://OWNER:CHANGE_ME@127.0.0.1:55432/bambo_finance_dev

APP_ENV=development
DEBUG=false
FRONTEND_ORIGIN=http://127.0.0.1:8000
