# Local environment and secrets
.env
.env.*
!.env.example
.venv/
.venv*/
ai-extraction-env/

# Frontend dependencies and generated output
node_modules/
dist/
coverage/

# Python and backend generated files
__pycache__/
*.py[cod]
.pytest_cache/
.pg-test-temp/

# Logs and temporary files
*.log
*.tmp
*.temp

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Release-validation artefacts: database dumps taken during rehearsal.
# A backup is the whole finance dataset in one file. It never belongs in version control,
# and the rehearsal that produces it is meant to be repeatable, not archived.
backend/.release-validation/

# Local database backups and dumps (never committed)
backups/
*.dump

# Schedule files. A schedule is a customer's plan: activity names, quantities and costs,
# and it belongs in the configured import root rather than in version control.
#
# `Sources/test_progress.mpp` and `Sources/BAMBO_FINANCE_INTEGRATION_KIT_v1.1.zip` were
# tracked before this rule and are NOT removed by it -- untracking a file the team reads
# from is a separate decision, and that MPP is the one whose bytes several recorded
# measurements name. The rule is here so the NEXT one does not arrive by accident.
*.mpp
*.mpx
backend/devhost/.release-*.backup

# The deployable package, produced by `npm run package` in frontend/. It is a copy of
# files already in this repository, derived from the module graph, so committing it would
# be a second version of the same code that can silently fall behind the first.
finance-package/
